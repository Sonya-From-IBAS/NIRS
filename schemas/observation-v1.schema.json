{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nirs-sql:observation:1.0.0",
  "title": "NIRS SQL observation v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "sql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "unit_kind": {
          "enum": [
            "full_sql",
            "payload_fragment",
            "non_sql",
            "unknown"
          ]
        }
      },
      "required": [
        "text",
        "unit_kind"
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dialect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "availability": {
              "enum": [
                "known",
                "unknown",
                "not_applicable"
              ]
            },
            "value": {
              "anyOf": [
                {
                  "enum": [
                    "mysql",
                    "postgresql",
                    "mssql",
                    "oracle"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence_ref": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "available_before_decision": {
              "type": "boolean"
            }
          },
          "required": [
            "availability",
            "value",
            "evidence_ref",
            "available_before_decision"
          ]
        },
        "active_role": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "availability": {
              "enum": [
                "known",
                "unknown",
                "not_applicable"
              ]
            },
            "value": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence_ref": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "available_before_decision": {
              "type": "boolean"
            }
          },
          "required": [
            "availability",
            "value",
            "evidence_ref",
            "available_before_decision"
          ]
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "availability": {
              "enum": [
                "known",
                "unknown",
                "not_applicable"
              ]
            },
            "value": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "coverage": {
                      "enum": [
                        "complete",
                        "partial"
                      ]
                    },
                    "scope_resources": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true,
                      "minItems": 1
                    },
                    "rules": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "effect": {
                            "enum": [
                              "allow",
                              "deny"
                            ]
                          },
                          "actions": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "enum": [
                                "select",
                                "insert",
                                "update",
                                "delete",
                                "grant",
                                "revoke",
                                "create_user",
                                "alter_role",
                                "export",
                                "execute"
                              ]
                            },
                            "uniqueItems": true,
                            "minItems": 1
                          },
                          "resources": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            },
                            "uniqueItems": true,
                            "minItems": 1
                          },
                          "condition": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "minLength": 1
                          }
                        },
                        "required": [
                          "effect",
                          "actions",
                          "resources",
                          "condition"
                        ]
                      }
                    }
                  },
                  "required": [
                    "coverage",
                    "scope_resources",
                    "rules"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence_ref": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "available_before_decision": {
              "type": "boolean"
            }
          },
          "required": [
            "availability",
            "value",
            "evidence_ref",
            "available_before_decision"
          ]
        },
        "application_operation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "availability": {
              "enum": [
                "known",
                "unknown",
                "not_applicable"
              ]
            },
            "value": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "operation_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "operation_id",
                    "description"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence_ref": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "available_before_decision": {
              "type": "boolean"
            }
          },
          "required": [
            "availability",
            "value",
            "evidence_ref",
            "available_before_decision"
          ]
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "availability": {
              "enum": [
                "known",
                "unknown",
                "not_applicable"
              ]
            },
            "value": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "coverage": {
                      "enum": [
                        "complete",
                        "partial"
                      ]
                    },
                    "scope_resources": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true,
                      "minItems": 1
                    },
                    "rules": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "effect": {
                            "enum": [
                              "allow",
                              "deny"
                            ]
                          },
                          "actions": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "enum": [
                                "select",
                                "insert",
                                "update",
                                "delete",
                                "grant",
                                "revoke",
                                "create_user",
                                "alter_role",
                                "export",
                                "execute"
                              ]
                            },
                            "uniqueItems": true,
                            "minItems": 1
                          },
                          "resources": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            },
                            "uniqueItems": true,
                            "minItems": 1
                          },
                          "condition": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "minLength": 1
                          }
                        },
                        "required": [
                          "effect",
                          "actions",
                          "resources",
                          "condition"
                        ]
                      }
                    },
                    "policy_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sensitive_resources": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true,
                      "minItems": 0
                    }
                  },
                  "required": [
                    "coverage",
                    "scope_resources",
                    "rules",
                    "policy_id",
                    "version",
                    "sensitive_resources"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence_ref": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "available_before_decision": {
              "type": "boolean"
            }
          },
          "required": [
            "availability",
            "value",
            "evidence_ref",
            "available_before_decision"
          ]
        }
      },
      "required": [
        "dialect",
        "active_role",
        "permissions",
        "application_operation",
        "policy"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "source_record_id": {
          "type": "string",
          "minLength": 1
        },
        "source_file_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "enum": [
            "public",
            "controlled",
            "llm_generated"
          ]
        },
        "purpose": {
          "enum": [
            "research",
            "contract_fixture"
          ]
        },
        "source_label": {},
        "generator": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "provider": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "model": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "prompt_version": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                }
              },
              "required": [
                "provider",
                "model",
                "prompt_version"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_id",
        "source_version",
        "source_record_id",
        "source_file_sha256",
        "origin",
        "purpose",
        "source_label",
        "generator"
      ]
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "annotation_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "supersedes": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "instruction_version": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "verified",
              "needs_review",
              "excluded"
            ]
          },
          "target_label": {
            "enum": [
              0,
              1,
              null
            ]
          },
          "threat_tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "sqli",
                "privilege_escalation",
                "exfiltration"
              ]
            },
            "uniqueItems": true,
            "minItems": 0
          },
          "representation_tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "comments",
                "hex_literal",
                "char_function",
                "url_encoding",
                "string_concatenation"
              ]
            },
            "uniqueItems": true,
            "minItems": 0
          },
          "exfiltration_channels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "file_export",
                "external_transfer",
                "unauthorized_read",
                "unknown"
              ]
            },
            "uniqueItems": true,
            "minItems": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "source_documentation",
                    "scenario_definition",
                    "policy_check",
                    "independent_review",
                    "attack_trace",
                    "source_label",
                    "generator_output",
                    "syntax_only"
                  ]
                },
                "reference": {
                  "type": "string",
                  "minLength": 1
                },
                "statement": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "reference",
                "statement"
              ]
            },
            "minItems": 1
          },
          "reviewer": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "human",
                  "ai",
                  "rule",
                  "unreviewed"
                ]
              },
              "reviewer_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "reviewer_id"
            ]
          }
        },
        "required": [
          "annotation_id",
          "revision",
          "supersedes",
          "instruction_version",
          "status",
          "target_label",
          "threat_tags",
          "representation_tags",
          "exfiltration_channels",
          "reason",
          "evidence",
          "reviewer"
        ]
      },
      "minItems": 1
    },
    "current_annotation_id": {
      "type": "string",
      "minLength": 1
    },
    "grouping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "scenario_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "template_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "campaign_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "parent_observation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 0
        }
      },
      "required": [
        "group_id",
        "scenario_id",
        "template_id",
        "campaign_id",
        "parent_observation_ids"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "unknown",
            "succeeded",
            "failed",
            "not_executed"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "outcome",
        "evidence_ref"
      ]
    }
  },
  "required": [
    "schema_version",
    "observation_id",
    "sql",
    "context",
    "source",
    "annotations",
    "current_annotation_id",
    "grouping",
    "execution"
  ]
}
